# Copie para `.env` e preencha os valores. O arquivo `.env` nunca deve ser versionado.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Gere um valor aleatório, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_LOG_LEVEL=INFO
# Expiração da sessão por inatividade (segundos).
SESSION_IDLE_TIMEOUT_SECONDS=1800
LOGIN_THROTTLE_RATE=10/min

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=sgca
POSTGRES_USER=sgca
POSTGRES_PASSWORD=
# Use `postgres` dentro do Docker Compose e `localhost` fora dele.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Destino do proxy /api do servidor de desenvolvimento do Vite.
VITE_BACKEND_URL=http://backend:8000
